## Backend environment variables (example)
#
# Copy to `.env` locally (do NOT commit real keys to git).
# The server will FAIL TO START if Groq API keys are missing.

# Server
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:8080,http://localhost:5173

# Database / Auth
MONGODB_URI=mongodb://localhost:27017/vocational
JWT_SECRET=replace-with-a-strong-secret
JWT_EXPIRES_IN=7d

# AI Provider (REQUIRED - server will exit if missing)
#
# The backend uses Groq (OpenAI-compatible API) for:
# - /api/ai/tutor (chatbot)
# - /api/ai/summarize (YouTube summaries)
# - /api/ai/quiz, /api/ai/notes, /api/ai/doubt
#
# Get your key from: https://console.groq.com/
# Model: openai/gpt-oss-20b (fast, cost-effective)
LLAMA_API_KEY=your_groq_api_key_here
LLAMA_API_URL=https://api.groq.com/openai/v1
LLAMA_MODEL=openai/gpt-oss-20b

